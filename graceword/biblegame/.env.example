# Copy the values you need into .env.local (development) or .env.production (build).

# Sub-path the site is hosted under, e.g. /bibleart.
# Leave empty to serve from the domain root.
NEXT_PUBLIC_BASE_PATH=/bibleart

# Public origin used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://test.grace-word.com

# Base URL of the image CDN. Images are stored under /images/*.jpg locally and
# mapped to `${NEXT_PUBLIC_IMAGE_BASE_URL}/<file>` when this is set.
NEXT_PUBLIC_IMAGE_BASE_URL=https://cdn.grace-word.com/game/images

# GA4 measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=G-7CEHJHLWK1
